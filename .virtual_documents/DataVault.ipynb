def merge_hub_external(df_source, table_name, hk_col):
    full_table_name = f"dv2_silver.{table_name}"
    table_path = f"{dv2_path}/{table_name}"
    df_dedup = df_source.dropDuplicates([hk_col])
    # Check physical path on disk rather than just the temporary catalog
    if not DeltaTable.isDeltaTable(spark, table_path):
        (
            df_dedup.write.format("delta").option("path", table_path).saveAsTable(full_table_name)
        )
    else:
        # Ensure table is registered in current session catalog, then MERGE
        spark.sql(f"CREATE TABLE IF NOT EXISTS {full_table_name} USING DELTA LOCATION '{table_path}'")
        dt = DeltaTable.forPath(spark, table_path)
        (
            dt.alias("t").merge(df_dedup.alias("s"), f"t.{hk_col} = s.{hk_col}")
            .whenNotMatchedInsertAll()
            .execute()
        )
    # Return the path so it can be used outside the function
    return table_path

